# Copy to .env and fill in. With no matching API key the app uses a deterministic mock LLM.

# LiteLLM model string. Default is Groq. Any LiteLLM-supported model works.
#   Groq:   groq/llama-3.3-70b-versatile, groq/openai-gpt-oss-20b
#   xAI:    xai/grok-4
#   OpenAI: openai/gpt-4o
LLM_MODEL=groq/llama-3.3-70b-versatile

# API key for the provider in LLM_MODEL. Only the matching one is used.
GROQ_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

LLM_TEMPERATURE=0.2

# Where pipeline artifacts are written.
DATA_DIR=data

# Name of the bundled/generated sample record.
SAMPLE_RECORD=synthetic
